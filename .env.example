# History: Church of Pakistan — environment template
# Copy to .env.local for local development:   cp .env.example .env.local
# NEVER commit .env.local. Put only variable NAMES in chat or tickets.
# Full reference: docs/DEPLOYMENT.md

# Public base URL (sitemap, robots, Open Graph, JSON-LD)
NEXT_PUBLIC_SITE_URL=http://localhost:5000

# —— First administrator (bootstrap) ——
# The first sign-in with ADMIN_EMAIL + the password behind ADMIN_PASSWORD_HASH
# creates the first admin account. After that, manage people in Admin → Accounts.
ADMIN_EMAIL=you@example.com
ADMIN_NAME=Your Name

# bcrypt hash of the password (plaintext ADMIN_PASSWORD is NOT supported).
# Make one with:
#   npm run admin:hash-password
# It prints two lines:
#   - for THIS file: every "$" escaped as "\$"  (Next.js expands "$" in .env files)
#   - for Vercel:    the raw hash (no backslashes)
# Example shape (not a real hash):
# ADMIN_PASSWORD_HASH=\$2b\$12\$replace-with-your-own-hash..................
ADMIN_PASSWORD_HASH=

# Session signing secret: at least 32 random characters, unique per environment.
# Optional locally (a random one is generated into data/local-store/), REQUIRED in production.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=

# Break-glass: re-enable the env login above even when admins already exist.
# Set true only temporarily (see docs/DEPLOYMENT.md#locked-out).
# ADMIN_RECOVERY_LOGIN=false

# LOCAL DEVELOPMENT ONLY: one-click sign-in without a password.
# Refused whenever NODE_ENV=production or on Vercel. Never "true" on a public host.
ADMIN_OPEN_PREVIEW=false

# —— Hosted storage (Vercel) — leave empty locally to use files ——
# Added automatically when you connect Upstash Redis / Vercel KV and Blob.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# BLOB_READ_WRITE_TOKEN=
# Separate PRIVATE Blob store for Contribute attachments (optional):
# CONTRIBUTIONS_BLOB_TOKEN=

# —— Contribute form (optional) ——
# Also POST each contribution (text + attachment metadata) to a webhook.
# CONTRIBUTE_WEBHOOK_URL=
# CONTRIBUTE_API_KEY=
