# History: Church of Pakistan — local env template
# Copy to .env.local for local development. NEVER commit .env.local.

# Base URL for local preview / audit
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:4000

# Contribution form backend (optional)
# When unset, the /contribute server action returns a clear
# "not configured" state and does NOT pretend to submit.
# CONTRIBUTE_WEBHOOK_URL=
# CONTRIBUTE_API_KEY=

# —— Curator admin (required for /admin) ——
# Single curator credentials. Prefer ADMIN_PASSWORD_HASH (bcrypt) over plaintext.
ADMIN_USERNAME=javed
# Optional plaintext fallback for local only — leave unset/unused when hash is set:
# ADMIN_PASSWORD=
# Preferred: bcrypt hash (cost 12+). Generate with bcryptjs; never commit a real hash.
# ADMIN_PASSWORD_HASH=
# Session signing secret — at least 32 characters; never commit real values.
ADMIN_SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars

# LOCAL ONLY — one-click curator Sign in without password.
# Default false. Set to exactly "true" only on trusted local machines.
# Production double-guard: blocked when NODE_ENV=production OR this is not "true".
ADMIN_OPEN_PREVIEW=false

# —— Production checklist (human deploy config) ——
# [ ] NODE_ENV=production on the host / platform
# [ ] ADMIN_OPEN_PREVIEW unset or false (never "true")
# [ ] ADMIN_PASSWORD_HASH set; ADMIN_PASSWORD unset
# [ ] ADMIN_SESSION_SECRET rotated (≥32 chars), unique per environment
# [ ] HTTPS terminated; Secure cookies will apply automatically in production
# [ ] Do not ship .env.local or real secrets in the deploy artifact
